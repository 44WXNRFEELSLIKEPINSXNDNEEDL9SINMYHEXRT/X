    "#Задание 77\n",
    "class MyFile:\n",
    "    def __init__(self, path, mode):\n",
    "        self.path = path\n",
    "        self.mode = mode\n",
    "    \n",
    "    def read(self):\n",
    "        if self.mode != \"read\":\n",
    "            return \"Invalid mode\"\n",
    "        try:\n",
    "            with open(self.path, 'r', encoding='utf-8') as file:\n",
    "                return file.read()\n",
    "        except Exception as e:\n",
    "            raise Exception(f\"Ошибка при чтении файла: {e}\")\n",
    "    def write(self, content):\n",
    "        if self.mode != \"write\" and self.mode != \"append\":\n",
    "            return \"Invalid mode\"\n",
    "        if self.mode == \"write\":\n",
    "            open_mode = 'w'\n",
    "        else:\n",
    "            open_mode = 'a'\n",
    "        try:\n",
    "            with open(self.path, open_mode, encoding='utf-8') as file:\n",
    "                file.write(content)\n",
    "        except Exception as e:\n",
    "            raise Exception(f\"Ошибка при записи файла: {e}\")\n",
    "    def read_url(self):\n",
    "        if self.mode != \"url\":\n",
    "            return \"Invalid mode\"\n",
    "        try:\n",
    "            with requests.get(self.path) as req:\n",
    "                return req.text\n",
    "        except Exception as e:\n",
    "            raise Exception(f\"Ошибка при чтении URL: {e}\")\n",
    "    def write_url(self, file):\n",
    "        if self.mode != \"url\":\n",
    "            return \"Invalid mode\"\n",
    "        try:\n",
    "            content = self.read_url()\n",
    "            with open(file, 'w', encoding='utf-8') as file:\n",
    "                file.write(content)\n",
    "        except Exception as e:\n",
    "            raise Exception(f\"Ошибка при записи файла: {e}\")\n",
    "    def count_urls(self):\n",
    "        if self.mode != \"url\":\n",
    "            return \"Invalid mode\"\n",
    "        content = self.read_url()\n",
    "        pattern = r'https?://\\S+'\n",
    "        matches = re.findall(pattern, content, re.IGNORECASE)\n",
    "        return len(matches)"
   ]
  },
