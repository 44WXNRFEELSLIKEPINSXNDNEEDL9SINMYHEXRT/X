   "source": [
    "#Задание 76\n",
    "r = requests.get(\"https://raw.githubusercontent.com/dm-fedorov/python_basic/master/data/opendata.stat\")\n",
    "text = r.text\n",
    "l = [list(x.split(\",\")) for x in list(text.split(\"\\n\")) if x.split(\",\")[0] == \"Средняя пенсия\"]\n",
    "count = 0\n",
    "sm = 0\n",
    "x = []\n",
    "y = []\n",
    "for i in l:\n",
    "    if i[1] == \"Забайкальский край\":\n",
    "        if i[2][3] == '8':\n",
    "            sm += int(i[3])\n",
    "            count += 1\n",
    "            x.append(i[2][5:])\n",
    "            y.append(int(i[3]))\n",
    "print('Среднюю пенсию в Забайкальском крае за 2018 год:', round(sm/count,1))\n",
    "plt.plot(x, y)\n",
    "plt.xlabel('Дата, месяц/день')\n",
    "plt.ylabel('Размер пенсии, руб')\n",
    "plt.title('Изменение пенсии за 2018 год в Забайкальском крае') #Название\n",
    "plt.show()"
   ]
  },
